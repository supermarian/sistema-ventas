rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function autenticado() {
      return request.auth != null;
    }

    function empleado() {
      return autenticado() && (
        request.auth.token.rol in ['Administrador', 'Jefe', 'Cajero', 'Consultor', 'Contador']
        || (exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
          && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol in ['Administrador', 'Jefe', 'Cajero', 'Consultor', 'Contador'])
        || (exists(/databases/$(database)/documents/accesos_admin/$(request.auth.uid))
          && get(/databases/$(database)/documents/accesos_admin/$(request.auth.uid)).data.activo == true)
      );
    }

    function administradorOJefe() {
      return autenticado() && (
        request.auth.token.rol in ['Administrador', 'Jefe']
        || (exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
          && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol in ['Administrador', 'Jefe'])
        || (exists(/databases/$(database)/documents/accesos_admin/$(request.auth.uid))
          && get(/databases/$(database)/documents/accesos_admin/$(request.auth.uid)).data.activo == true)
      );
    }

    function administradorOJefePorToken() {
      return autenticado() && (
        request.auth.token.admin == true || request.auth.token.rol in ['Administrador', 'Jefe']
        || (exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
          && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol in ['Administrador', 'Jefe'])
        || (exists(/databases/$(database)/documents/accesos_admin/$(request.auth.uid))
          && get(/databases/$(database)/documents/accesos_admin/$(request.auth.uid)).data.activo == true)
      );
    }

    function accesoAdministrativo() {
      return administradorOJefePorToken();
    }

    function gestorUsuarios() {
      return autenticado() && (
        request.auth.token.admin == true
        || request.auth.token.rol in ['Administrador', 'Jefe']
        || (exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
          && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol in ['Administrador', 'Jefe'])
        || (exists(/databases/$(database)/documents/accesos_admin/$(request.auth.uid))
          && get(/databases/$(database)/documents/accesos_admin/$(request.auth.uid)).data.activo == true)
      );
    }

    function permisoAuditoria() {
      return autenticado() && (
        request.auth.token.admin == true
        || request.auth.token.rol in ['Administrador', 'Jefe']
        || (exists(/databases/$(database)/documents/accesos_admin/$(request.auth.uid))
          && get(/databases/$(database)/documents/accesos_admin/$(request.auth.uid)).data.activo == true)
        || (
          (request.auth.token.rol in ['Administrador', 'Jefe', 'Consultor', 'Contador']
            || (exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
              && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol in ['Administrador', 'Jefe', 'Consultor', 'Contador']))
          && (!exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
            || !('permisos' in get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data)
            || get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.permisos.auditoria == true)
        )
      );
    }

    function gestorCuadres() {
      return autenticado() && permisoAuditoria() && (
        request.auth.token.admin == true
        || request.auth.token.rol in ['Administrador', 'Jefe']
        || (exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
          && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol in ['Administrador', 'Jefe'])
        || (exists(/databases/$(database)/documents/accesos_admin/$(request.auth.uid))
          && get(/databases/$(database)/documents/accesos_admin/$(request.auth.uid)).data.activo == true)
      );
    }

    function permisoRecepciones() {
      return autenticado() && (
        request.auth.token.admin == true
        || request.auth.token.rol in ['Administrador', 'Jefe']
        || (exists(/databases/$(database)/documents/accesos_admin/$(request.auth.uid))
          && get(/databases/$(database)/documents/accesos_admin/$(request.auth.uid)).data.activo == true)
        || (exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
          && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.permisos.recepciones == true)
      );
    }

    // Preparado para cuando cada documento usuarios/{uid} tenga el rol.
    function administrador() {
      return autenticado() && (
        request.auth.token.admin == true || request.auth.token.rol == 'Administrador'
        || (exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
          && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'Administrador')
        || (exists(/databases/$(database)/documents/accesos_admin/$(request.auth.uid))
          && get(/databases/$(database)/documents/accesos_admin/$(request.auth.uid)).data.activo == true)
      );
    }

    function gestorPrecios() {
      return autenticado() && (
        request.auth.token.admin == true
        || request.auth.token.rol == 'Administrador'
        || request.auth.token.rol == 'Jefe'
        || (exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
          && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol in ['Administrador', 'Jefe'])
      );
    }

    function margenValido() {
      return (!('costoActual' in request.resource.data)
          || request.resource.data.costoActual is number)
        && (!('precio' in request.resource.data)
          || request.resource.data.precio is number)
        && (!('margenMinimo' in request.resource.data)
          || (request.resource.data.margenMinimo is number
            && request.resource.data.margenMinimo >= 0))
        && (
          !('costoActual' in request.resource.data)
          || !('precio' in request.resource.data)
          || request.resource.data.costoActual <= 0
          || request.resource.data.precio >= request.resource.data.costoActual
            * (1 + ((('margenMinimo' in request.resource.data)
              && request.resource.data.margenMinimo > 2)
              ? request.resource.data.margenMinimo : 2) / 100)
          || (administrador()
            && 'autorizacionMargen' in request.resource.data
            && request.resource.data.autorizacionMargen.autorizadoPor == request.auth.uid
            && request.resource.data.autorizacionMargen.motivo is string
            && request.resource.data.autorizacionMargen.motivo.size() > 0)
        );
    }

    match /usuarios/{usuarioId} {
      allow read: if gestorUsuarios() || (autenticado() && resource.data.email == request.auth.token.email);
      allow create, update, delete: if gestorUsuarios();
    }

    match /accesos_admin/{usuarioId} {
      allow read: if autenticado() && request.auth.uid == usuarioId;
      allow write: if request.auth.token.admin == true || request.auth.token.rol == 'Administrador';
    }

    match /dispositivos_autorizados/{dispositivoId} {
      allow read: if administradorOJefe()
        || (autenticado() && resource.data.uid == request.auth.uid);
      allow create: if administradorOJefe()
        || (autenticado()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.estado == 'PENDIENTE');
      allow update: if administradorOJefe()
        || (autenticado()
          && resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ultimoAcceso', 'navegador', 'plataforma']));
      allow delete: if administradorOJefe();
    }

    match /productos/{productoId} {
      allow read: if autenticado();
      allow create: if administrador() && margenValido();
      allow update: if (administrador()
        || (gestorPrecios()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['precio', 'seguimientoPrecio'])))
        && margenValido();
      allow delete: if administrador();
    }

    match /clientes/{clienteId} {
      allow read: if empleado() || (autenticado() && resource.data.uid == request.auth.uid);
      allow create: if empleado() || (autenticado() && request.resource.data.uid == request.auth.uid);
      allow update: if empleado() || (autenticado() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre', 'telefono', 'direccion', 'cedula', 'rnc']));
      allow delete: if administrador();
    }

    // Una venta se crea desde el POS, pero nunca se edita ni se elimina.
    match /ventas_realizadas/{ventaId} {
      allow read: if empleado() || (autenticado() && resource.data.uidCliente == request.auth.uid);
      allow create: if empleado();
      allow update: if administradorOJefe()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'tipoComprobante', 'nroFactura', 'fecha', 'cliente', 'total',
          'ultimaCorreccionId', 'ultimaCorreccionPor', 'ultimaCorreccionEn'
        ])
        && request.resource.data.ultimaCorreccionPor == request.auth.uid;
      allow delete: if false;
    }

    match /correcciones_facturas/{correccionId} {
      allow read: if administradorOJefe();
      allow create: if administradorOJefe()
        && request.resource.data.usuarioUid == request.auth.uid
        && request.resource.data.motivo is string
        && request.resource.data.motivo.size() > 0;
      allow update, delete: if false;
    }

    match /clientes_portal/{clienteId} {
      allow read: if autenticado() && request.auth.uid == clienteId;
      allow create, update: if autenticado() && request.auth.uid == clienteId;
      allow delete: if false;
    }

    match /cotizaciones/{cotizacionId} {
      allow create: if autenticado() && request.resource.data.uidCliente == request.auth.uid;
      allow read: if autenticado() && (
        resource.data.uidCliente == request.auth.uid || request.auth.token.admin == true
        || administradorOJefe()
      );
      allow update: if autenticado() && (
        resource.data.uidCliente == request.auth.uid || request.auth.token.admin == true
        || administradorOJefe()
      );
      allow delete: if false;
    }

    match /deudas_clientes/{deudaId} {
      allow read: if empleado() || (autenticado() && resource.data.idCliente == request.auth.uid);
      allow create: if empleado();
      allow update: if empleado();
      allow delete: if administrador();
    }

    // Compatibilidad con los créditos registrados antes de usar deudas_clientes.
    match /clientes_fiado/{clienteId} {
      allow read: if autenticado();
      allow update: if autenticado();
      allow create: if administrador();
      allow delete: if administrador();
    }

    match /pagos_creditos/{pagoId} {
      allow read: if empleado();
      allow create: if empleado();
      allow update, delete: if false;
    }

    match /movimientos_caja/{movimientoId} {
      allow read: if autenticado();
      allow create: if autenticado();
      allow update, delete: if administrador();
    }

    match /alertas_auditoria/{alertaId} {
      allow read: if administrador();
      allow create: if autenticado();
      allow update, delete: if administrador();
    }

    match /ventas_precio/{ventaPrecioId} {
      allow read: if administrador();
      allow create: if autenticado();
      allow update, delete: if administrador();
    }

    match /historial_precios/{cambioId} {
      allow read: if administrador();
      allow create: if autenticado();
      allow update, delete: if administrador();
    }

    match /recepciones_compras/{recepcionId} {
      allow read: if administradorOJefe();
      allow write: if false;
    }

    match /recepciones_compras/{recepcionId}/lineas/{lineaId} {
      allow read: if administradorOJefe();
      allow write: if false;
    }

    match /movimientos_inventario/{movimientoId} {
      allow read: if administradorOJefe();
      allow write: if false;
    }

    match /proveedores/{proveedorId} {
      allow read: if autenticado();
      allow create, update, delete: if administradorOJefe();
    }

    match /almacenes/{almacenId} {
      allow read: if autenticado();
      allow create, update, delete: if administradorOJefe();
    }

    match /revisiones_cierres/{revisionId} {
      allow read: if administradorOJefe()
        || (autenticado() && request.auth.token.rol in ['Consultor', 'Contador']);
      allow write: if false;
    }

    match /cierres_caja/{cierreId} {
      allow read: if permisoAuditoria();
      allow create: if autenticado()
        && request.resource.data.estado == 'PENDIENTE_REVISION'
        && request.resource.data.creadoPorUid == request.auth.uid;
      allow update: if gestorCuadres()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'estado', 'revisionIniciadaEn', 'revisionIniciadaPorUid', 'revisionIniciadaPorEmail',
          'aprobadoEn', 'aprobadoPorUid', 'aprobadoPorEmail',
          'observadoEn', 'observadoPorUid', 'observadoPorEmail', 'motivoObservacion',
          'archivadoEn', 'archivadoPorUid', 'archivadoPorEmail', 'motivoArchivo'
        ])
        && (
          (request.resource.data.estado == 'EN_REVISION'
            && (resource.data.estado == 'PENDIENTE_REVISION' || resource.data.estado == 'CERRADO'
              || resource.data.estado == 'OBSERVADO' || resource.data.estado == 'ARCHIVADO' || !('estado' in resource.data))
            && request.resource.data.revisionIniciadaPorUid == request.auth.uid)
          || (request.resource.data.estado == 'APROBADO'
            && resource.data.estado == 'EN_REVISION'
            && request.resource.data.aprobadoPorUid == request.auth.uid)
          || (request.resource.data.estado == 'OBSERVADO'
            && (resource.data.estado == 'EN_REVISION' || resource.data.estado == 'PENDIENTE_REVISION')
            && request.resource.data.observadoPorUid == request.auth.uid
            && request.resource.data.motivoObservacion is string
            && request.resource.data.motivoObservacion.size() > 0)
          || (request.resource.data.estado == 'ARCHIVADO'
            && resource.data.estado == 'APROBADO'
            && request.resource.data.archivadoPorUid == request.auth.uid)
        );
      allow delete: if false;
    }

    match /recepciones_compras/{recepcionId} {
      allow read: if permisoRecepciones();
      allow create: if permisoRecepciones()
        && request.resource.data.estado == 'BORRADOR'
        && request.resource.data.usuarioUid == request.auth.uid;
      allow update: if permisoRecepciones()
        && resource.data.estado == 'BORRADOR'
        && request.resource.data.estado == 'BORRADOR'
        && request.resource.data.usuarioUid == resource.data.usuarioUid;
      allow delete: if permisoRecepciones() && resource.data.estado == 'BORRADOR';
    }

    match /recepciones_compras/{recepcionId}/lineas/{lineaId} {
      allow read, write: if false;
    }

    match /configuracion-venta-factura/{configuracionId} {
      allow read, write: if autenticado();
    }

    match /configuracion-sistema/{configuracionId} {
      allow read: if autenticado();
      allow write: if administradorOJefe();
    }

    match /configuracion-sistema/comprobantes {
      allow read, write: if administradorOJefe();
    }

    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
