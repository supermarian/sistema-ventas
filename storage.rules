rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function usuarioGestorProductos() {
      return request.auth != null && (
        request.auth.token.admin == true
        || request.auth.token.rol in ['Administrador', 'Jefe']
        || (firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.permisos.productos == true)
      );
    }

    match /productos/{productoId}/{archivo} {
      allow read: if request.auth != null;
      allow write: if usuarioGestorProductos()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if usuarioGestorProductos();
    }
  }
}
